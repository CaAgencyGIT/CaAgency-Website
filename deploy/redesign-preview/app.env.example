# /etc/caagency-website-redesign/app.env  (root:caagency-redesign 0640)
# Redesign preview only. Never copy production credentials into this file.
DATABASE_URL=postgresql://caagency_website_redesign:CHANGE_ME@127.0.0.1:5432/caagency_website_redesign
MEDIA_DIRECTORY=/var/lib/caagency-website-redesign/media
CONTACT_CAPTURE_DIRECTORY=/var/lib/caagency-website-redesign/contact-captures

# Preview mode: noindex, no analytics, contact form submissions are stored
# locally and never emailed.
PREVIEW_MODE=true
NEXT_PUBLIC_PREVIEW_MODE=true
EMAIL_DELIVERY_ENABLED=false

AUTH_SECRET=CHANGE_ME_RANDOM
AUTH_TRUST_HOST=true
ALLOWED_ORIGINS=https://redesign.caagency.com

# Optional: lets the contact form be tested. Add redesign.caagency.com to the
# Turnstile widget's hostnames first.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=redesign.caagency.com

# Must stay unset here: CLOUDFLARE_PURGE_TOKEN, CLOUDFLARE_ZONE_ID,
# AZ_*/AZURE_AD_* (mail and admin login), NEXT_PUBLIC_GA_MEASUREMENT_ID.
