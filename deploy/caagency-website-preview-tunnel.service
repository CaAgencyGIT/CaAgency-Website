[Unit]
Description=Temporary Cloudflare preview tunnel for CA Agency website
After=network-online.target caagency-website.service
Wants=caagency-website.service

[Service]
Type=simple
User=caagency-web
Group=caagency-web
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20242 --url http://127.0.0.1:3001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
